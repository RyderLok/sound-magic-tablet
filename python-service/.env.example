# Optional SiliconFlow Qwen3-Omni open-ended audio semantic analysis.
# Copy to python-service/.env (gitignored) — never commit real keys.
# Used by POST /analyze/wav → response.semantic (does not change brushParams).

SILICONFLOW_API_KEY=
SILICONFLOW_OMNI_ENABLED=1
SILICONFLOW_OMNI_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Supabase Sounds storage (service role — server only, never ship to frontend)
# If BOTH URL and SERVICE_ROLE_KEY are empty, uploads fall back to LOCAL disk:
#   <this-package>/sounds/*.wav  (+ index.json)
# On Mac with LaunchAgent that is usually:
#   ~/Library/Application Support/Piko/python-runtime/sounds/
# Check GET http://127.0.0.1:8001/health → supabase.localDir / supabase.hint
# After filling keys: sync runtime, restart :8001, then:
#   python migrate_local_to_supabase.py
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SOUNDS_BUCKET=sounds
