# Dependencies
node_modules/

# Python virtual environments (Windows .venv + Mac .venv-mac)
.venv/
.venv-mac/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# Secrets & local env
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
esp32/**/wifi_secrets.h
ios/PikoShell/**/Secrets.plist


# Logs
logs/
*.log

# Build / generated output
dist/
build/
out/
*.egg
python-service/output/*
!python-service/output/.gitkeep
python-service/sounds/*
